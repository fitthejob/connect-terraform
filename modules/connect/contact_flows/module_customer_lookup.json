  "Actions": [
    {
      "Identifier": "InvokeCustomerLookup",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "InvocationTimeLimitSeconds": "8",
        "LambdaFunctionARN": "arn:aws:lambda:us-east-1:084396578198:function:customer-lookup-dev:live"
      },
      "Transitions": {
        "NextAction": "CheckCustomerStatus",
        "Errors": [
          {
            "NextAction": "SetUnknownAttributes",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "CheckCustomerStatus",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.External.customerStatus"
      },
      "Transitions": {
        "NextAction": "SetUnknownAttributes",
        "Conditions": [
          {
            "NextAction": "SetKnownAttributes",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "KNOWN"
              ]
            }
          },
          {
            "NextAction": "SetSuspendedAttributes",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "SUSPENDED"
              ]
            }
          },
          {
            "NextAction": "SetUnknownAttributes",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "UNKNOWN"
              ]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "SetUnknownAttributes",
            "ErrorType": "NoMatchingCondition"
          }
        ]
      }
    },
    {
      "Identifier": "SetKnownAttributes",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "TargetContact": "Current",
        "Attributes": {
          "CustomerStatus": "KNOWN",
          "CustomerId": "$.External.customerId",
          "CustomerTier": "$.External.customerTier"
        }
      },
      "Transitions": {
